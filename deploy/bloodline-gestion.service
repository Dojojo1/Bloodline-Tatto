[Unit]
Description=Bloodline Tattoo management service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dojojo
WorkingDirectory=/home/dojojo/Documents/bloodline_gestion
EnvironmentFile=/home/dojojo/Documents/bloodline_gestion/.env
ExecStart=/home/dojojo/Documents/bloodline_gestion/.venv/bin/python -m uvicorn backend.app:create_app --factory --host 127.0.0.1 --port 8082 --no-access-log --no-proxy-headers
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
