[Unit]
Description=Local routing for the shared ngrok address
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dojojo/Documents/bloodline
ExecStart=/home/dojojo/.local/bin/caddy run --config /home/dojojo/Documents/bloodline/deploy/ngrok-router.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
